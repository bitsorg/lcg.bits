diff -Naur '--exclude=*.gz' '--exclude=.git' .gitlab-ci.yml .gitlab-ci.yml
--- .gitlab-ci.yml	1970-01-01 01:00:00.000000000 +0100
+++ .gitlab-ci.yml	2026-07-22 12:47:00.000000000 +0200
@@ -0,0 +1,20 @@
+stages:
+  - LCG
+
+LCG_x86_64-alma9:
+  only:
+    variables:
+     - $CI_SERVER_HOST=="gitlab.cern.ch"
+  image: gitlab-registry.cern.ch/sft/docker/alma9-core:latest
+  tags:
+    - k8s-cvmfs
+  stage: LCG
+  script:
+    - |
+      source /cvmfs/sft.cern.ch/lcg/views/setupViews.sh LCG_110 x86_64-el9-gcc15-opt
+      set +x
+      cmake -S . -B BUILD -DCOMPILE_OPTION=BASIC -DCMAKE_INSTALL_PREFIX=INSTALL -DCMAKE_CXX_FLAGS="-Wpedantic -Wall -Wextra" -DCOMPILE_LIBRARY=ON
+      cmake --build BUILD -j 4  --verbose 
+      cmake --install BUILD 
+      cmake --build BUILD --target clean 
+
