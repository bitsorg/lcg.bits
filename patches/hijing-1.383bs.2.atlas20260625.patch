# HIJING 1.383bs.2.atlas20260625 ATLAS patch
#
# Applies the source changes from the official ATLAS tag:
# https://gitlab.cern.ch/atlas-physics/pmg/gensoftware/hijing/-/tags/1.383bs.2.atlas20260625
#
# Original commit: 59196e621a9ea005f7daebfef9f1c5d47f13af92
# Author: Andrii Verbytskyi <andrii.verbytskyi@mpp.mpg.de>
# Subject: Add ATLAS patches
#
# HIJING defines a generic Fortran symbol named RAN. This symbol can clash
# with RAN implementations from other generator libraries linked in the ATLAS
# software environment. The ATLAS change renames it to ATL_RAN and updates
# all calls in HIJING. The configure script is set to use /bin/bash and
# -ffixed-line-length-none so the reformatted fixed-form sources are not
# truncated at column 72.
#
diff -Naur configure configure
--- configure	2007-06-07 18:06:53.000000000 +0200
+++ configure	2026-07-23 15:22:38.002831630 +0200
@@ -1,4 +1,4 @@
-#!/bin/sh
+#!/bin/bash
 #
 # Configuration script, to be run before compilation
 #
@@ -56,4 +56,4 @@
-export FFLAGS_OPT="-O2 -Wuninitialized"
+export FFLAGS_OPT="-O2 -Wuninitialized -ffixed-line-length-none"
 export FFLAGS_DBG=-g
 export CFLAGS_OPT=-O2
 export CFLAGS_DBG=-g
